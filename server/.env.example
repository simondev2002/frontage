# ---- Core ----
NODE_ENV=development
PORT=5150
BRAND_NAME=Frontage
APP_HOST=localhost:5150            # production: app.frontageweb.com
SITES_DOMAIN=localhost:5150        # production: frontageweb.com  (sites live at <slug>.frontageweb.com)
PUBLIC_BASE_URL=http://localhost:5150   # production: https://app.frontageweb.com
CNAME_TARGET=sites.frontageweb.com   # what customers CNAME their www to
SERVER_IPV4=                       # your server's public IPv4 for apex A records
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=                       # enables GET /api/admin/stats
SUPPORT_EMAIL=hello@frontageweb.com
TRUST_PROXY=true

# ---- AI (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5             # generation model
AI_EDIT_MODEL=claude-sonnet-5      # edit model (Opus for generation, Sonnet keeps edits at a few cents)
AI_CHEAP_MODEL=claude-haiku-4-5    # moderation
AI_EFFORT_GENERATE=high
AI_EFFORT_EDIT=medium
AI_SERVER_FALLBACKS=true
AI_DAILY_BUDGET_USD=60             # platform-wide daily AI spend cap (pauses AI when reached)
AI_USER_DAILY_BUDGET_USD=6         # per-account daily AI spend cap

# ---- Plans ----
FREE_FIRST_GENERATION=true         # let new users see their site before paying
FREE_EDITS=3                       # free AI changes per month on the first site (enough to feel it; publishing still needs a plan)
STARTER_EDITS=40
BUSINESS_EDITS=120
STARTER_SITES=1
BUSINESS_SITES=3

# ---- Apple ----
APPLE_BUNDLE_ID=com.frontage.app
APPLE_APP_ID=6809199627                # App Store Connect > App Information > Apple ID
APPLE_TEAM_ID=
APPLE_PRODUCT_STARTER=com.frontage.app.starter.monthly
APPLE_PRODUCT_BUSINESS=com.frontage.app.business.monthly
APPLE_ALLOW_SANDBOX=true
# Sign in with Apple key (for token revocation on account deletion)
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY_FILE=./keys/AuthKey_SIWA.p8
# App Store Server API key (optional)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_FILE=./keys/AuthKey_IAP.p8
# APNs key (push for new leads)
APNS_KEY_ID=
APNS_PRIVATE_KEY_FILE=./keys/AuthKey_APNS.p8
APNS_PRODUCTION=false

# ---- Cloudflare (recommended: DDoS protection, cache, certificates) ----
CF_API_TOKEN=                      # token with Zone:DNS:Edit (Caddy wildcard cert) + SSL and Certificates:Edit (custom hostnames)
CF_ZONE_ID=                        # zone id of your sites domain
CF_SAAS=false                      # true = customers' domains are proxied through Cloudflare for SaaS

# ---- Stripe (optional web checkout) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
EXTERNAL_LINK_US=false             # show "subscribe on the web" in the US storefront

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Frontage <hello@frontageweb.com>

# App Review sign-in (set only while a review is in progress; both empty = disabled)
REVIEW_EMAIL=
REVIEW_CODE=
