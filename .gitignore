# Secrets and local data (server/.gitignore repeats these for the server folder)
server/.env
server/data/
server/certs/
server/keys/
server/node_modules/
*.log

# Xcode project is generated by XcodeGen from ios/project.yml; never commit it
ios/Frontage.xcodeproj/
ios/*.xcworkspace/
ios/build/
ios/DerivedData/
*.ipa
*.dSYM
*.dSYM.zip
*.xcuserstate
xcuserdata/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
server/.env.production
server/tools/design-lab/.env
server/tools/design-lab/out/
